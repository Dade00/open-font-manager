{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Font Manager",
  "version": "0.2.0",
  "identifier": "com.rustfontmanager.openfontmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Font Manager",
        "width": 1440,
        "height": 920,
        "minWidth": 640,
        "minHeight": 540,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1M0M0MzZCNTNEQUE3MjYKUldRbXA5cFRhME04SmFWTmR0L2VucUtyelc1OHJmRy9CcG9DUVNVZmRKQzFLMzVHSEUzVXc3bksK",
      "endpoints": [
        "https://github.com/Dade00/open-font-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
